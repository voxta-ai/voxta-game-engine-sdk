# Unity emits empty YAML values with a trailing space in serialized project and
# plug-in metadata. Preserve them verbatim without treating them as diff errors.
unity/Compatibility~/**/ProjectSettings/*.asset whitespace=-trailing-space
unity/Compatibility~/**/*.meta whitespace=-trailing-space
unity/Compatibility~/**/*.unity whitespace=-trailing-space
unity/Tests/Runtime/ModelProtocolTests.cs.meta whitespace=-trailing-space
unity/Documentation~/RUNTIME-MODEL-DEPENDENCY-UPGRADE-PLAN.md whitespace=-trailing-space
